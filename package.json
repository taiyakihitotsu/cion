{
  "name": "@taiyakihitotsu/cion",
  "version": "0.2.0",
  "private": false,
  "description": "Clojure implemented on TypeScript at the type-level.",
  "main": "index.d.ts",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsc --emitDeclarationOnly",
    "build:watch": "npx tsc --watch",
    "check": "npx tsc --noEmit",
    "check:test": "npx tsc --noEmit --project tsconfig.test.json",
    "check:smith": "sh ./scripts/sandbox-smith.sh && sh ./scripts/check-smith.sh",
    "format:smith": "npm --prefix submodules/condsmith run format:smith ../../src",
    "run": "npx ts-node src/index.ts",
    "precommit": "sh scripts/precommit.sh",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taiyakihitotsu/cion.git"
  },
  "devDependencies": {
    "@types/node": "^18.19.22",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "author": "taiyakihitotsu <taiyakihitotsu@proton.me> https://github.com/taiyakihitotsu",
  "license": "3-clause BSD license"
}
